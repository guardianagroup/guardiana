<?xml version="1.0" encoding="utf-8"?>
<!-- Los textos del instalador en español. Los que ve una persona al instalar viven aquí y no
     dentro de guardiana.wxs: así el mismo instalador se compila en cada idioma sin tocar la
     definición del paquete (22 sep 2026). -->
<WixLocalization xmlns="http://wixtoolset.org/schemas/v4/wxl" Culture="es-ES" Codepage="1252">
  <String Id="Descripcion" Value="GUARDIANA: el navegador ZERO, la vigilancia de todo el equipo y el Vigía. Todo ocurre en este equipo, sin cuenta." />
  <String Id="AbrirPanel" Value="Abrir el panel de GUARDIANA" />
  <String Id="AbrirZero" Value="Abrir el navegador GUARDIANA ZERO" />
  <String Id="VersionMasNueva" Value="Ya hay una versión más nueva de GUARDIANA instalada." />
  <String Id="ServicioDescripcion" Value="GUARDIANA: vigila a qué empresas se conecta este equipo y protege su DNS. Todo ocurre en este equipo, sin cuenta." />
  <String Id="ArchivoLeeme" Value="LEEME.txt" />
  <!-- 1.0.49: la barra de progreso y las pantallas de WixUI con nuestras palabras (revisión del 30 Oct 2026: la primera
       pedía aceptar un «contrato» que no existe y la última no decía que GUARDIANA quedó en marcha) -->
  <String Id="ProgresoCerrarZero" Value="Cerrando GUARDIANA ZERO para actualizarlo…" />
  <String Id="ProgresoVigilante" Value="Creando el vigilante del DNS…" />
  <String Id="ProgresoDns" Value="Configurando el DNS de este equipo…" />
  <String Id="ApagarVpn" Value="Apagar la VPN de GUARDIANA" />
  <String Id="ProgresoApagarVpn" Value="Quitando el bloqueo de la VPN…" />
  <String Id="ProgresoHogar" Value="Cerrando el Modo Hogar…" />
  <String Id="ProgresoDevolverDns" Value="Devolviendo el DNS de antes…" />
  <String Id="ProgresoQuitarVigilante" Value="Quitando el vigilante del DNS…" />
  <String Id="WelcomeEulaDlgTitle" Value="{\WixUI_Font_Title}Antes de instalar GUARDIANA" />
  <String Id="WelcomeEulaDlgLicenseAcceptedCheckBox" Value="He leído qué hará la instalación y acepto los Términos de uso" />
  <String Id="ExitDialogTitle" Value="{\WixUI_Font_Bigger}GUARDIANA está instalada" />
  <String Id="ExitDialogDescription" Value="El servicio de GUARDIANA ya está en marcha. Pulsa «Finalizar» para cerrar." />
</WixLocalization>
