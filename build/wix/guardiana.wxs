<?xml version="1.0" encoding="UTF-8"?>
<!--
  Guardiana Windows installer (brief §11), WiX v4/v5 schema.
  Built by build/msi.ps1 (on Windows, WiX 5) with:
    wix build -arch x64 -culture es-ES -ext WixToolset.UI.wixext -ext WixToolset.Util.wixext \
      -d Version=<x.y.z> -d Exe=<path to guardiana.exe> -d Readme=build/wix/LEEME.txt \
      -d Welcome=build/wix/bienvenida.rtf -o dist/<v>/guardiana-<v>-windows-x64.msi build/wix/guardiana.wxs
  What it does: copies guardiana.exe to Program Files\Guardiana, registers and
  starts the "guardiana" service (same arguments as `guardiana service install`),
  adds a Start menu shortcut that opens the panel and, on a first install, points
  this PC's DNS at Guardiana (the `dns` command with apply and yes, with an exact backup;
  the welcome screen says so before "Install", and VIGILAR=0 on the msiexec line
  leaves it for the panel). Until 28 Sep 2026 that step was a button in the panel,
  and a person who installed and did not find the button saw an empty panel and
  concluded the program did not work. On uninstall: the service is
  stopped, then Home Mode is closed (firewall rule removed) and the DNS is
  restored exactly as it was, then the service is deleted and the files removed.
  The extract in ProgramData\Guardiana stays: it belongs to the user.
  UpgradeCode never changes between versions (it is what makes upgrades replace
  the previous version instead of installing twice).
-->
<!-- The installer's language, left for GUARDIANA ZERO (18 Oct 2026, the owner: English first on
     screen unless the Spanish or Portuguese installer was chosen). -d Idioma=es|en|pt. -->
<?ifndef Idioma?>
<?define Idioma = "en"?>
<?endif?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <!-- The package is language neutral (-d Lang=0) in the three builds, and the words a person
       reads come from build/wix/loc-<culture>.wxl. It has to be one ProductLanguage for the
       three: with one LCID each, Windows Installer saw three different products and installing
       the English one over the Spanish left both registered (measured, 22 sep 2026). Neutral
       also replaces the LCID 10 of 15 sep 2026, which said "Español" of a program that speaks
       three languages and picks by the system's own. -->
  <Package Name="GUARDIANA"
           Manufacturer="GUARDIANA GROUP"
           Version="$(var.Version)"
           UpgradeCode="0d4fae13-1842-4b29-a2e6-1939a9564b47"
           Language="$(var.Lang)"
           Codepage="1252"
           Scope="perMachine"
           InstallerVersion="500"
           Compressed="yes">

    <SummaryInformation Description="!(loc.Descripcion)" Manufacturer="GUARDIANA GROUP" Keywords="GUARDIANA" Comments="!(loc.Descripcion)" />
    <!-- 1.0.49 (revisión del 30 Oct 2026): «Configuración › Aplicaciones» con la web, la ayuda y el contacto, como un programa
         de marca, y la carpeta donde quedó instalado. -->
    <Property Id="ARPURLINFOABOUT" Value="https://guardianagroup.com/" />
    <Property Id="ARPHELPLINK" Value="https://guardianagroup.com/contacto.html" />
    <Property Id="ARPURLUPDATEINFO" Value="https://guardianagroup.com/instalar.html" />
    <Property Id="ARPCONTACT" Value="hola@guardianagroup.com" />
    <SetProperty Id="ARPINSTALLLOCATION" Value="[INSTALLFOLDER]" After="CostFinalize" Sequence="execute" />
    <!-- 1.0.50 (dueño, 30 Oct 2026, 22:10, con un vídeo: «tardó muchísimo… la persona pensará que no descarga y
         cancelará»): la pantalla «Instalando GUARDIANA» se quedaba unos 23 segundos con «Estado» vacío y la barra a
         cero mientras Windows creaba un punto de restauración del sistema antes de empezar. Un programa de ~60 MB que
         se desinstala limpio desde Configuración no lo necesita: MSIFASTINSTALL=1 lo omite, y la barra avanza desde
         el primer segundo. -->
    <Property Id="MSIFASTINSTALL" Value="1" />

    <!-- Two screens only: what the installer does and does not (build/wix/textos/bienvenida-XX.rtf)
         with "Install", then "Finish" with "Open Guardiana" ticked, which opens the panel in the
         browser as the user (not elevated). No folder choice, no options. Everything a person
         reads comes from build/wix/loc-<culture>.wxl, so the same package builds in Spanish,
         English and Portuguese: whoever downloads from the English page must not be handed a
         Spanish installer (22 Sep 2026). -->
    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.Welcome)" />
    <!-- The brand instead of WiX's red sample artwork (1.0.1), redrawn in 1.0.18 (the owner:
         «no se ve la palabra… no se ven simétricos»): a navy side with the white symbol and the
         name centred under it on the first and last screens (493x312), and the same, small, on
         the right of the top band of the others (493x58), where WiX leaves room free of text.
         build/wix/imagenes.py draws them. The package name is the brand, in capitals, as
         Windows shows it in every screen and in «Aplicaciones instaladas». -->
    <WixVariable Id="WixUIDialogBmp" Value="$(var.Dialogo)" />
    <WixVariable Id="WixUIBannerBmp" Value="$(sys.SOURCEFILEDIR)banner.bmp" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="!(loc.AbrirPanel)" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <SetProperty Id="WixShellExecTarget" Value="[MenuDir]Guardiana.lnk" After="CostFinalize" Sequence="ui" />
    <CustomAction Id="LaunchPanel" DllEntry="WixShellExec" Impersonate="yes" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" />
    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchPanel" Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>
    <MajorUpgrade AllowSameVersionUpgrades="yes" IgnoreLanguage="yes" DowngradeErrorMessage="!(loc.VersionMasNueva)" />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Guardiana">
        <Directory Id="ZERODIR" Name="ZERO" />
      </Directory>
      <!-- 1.0.49 (revisión del 30 Oct 2026, grave): el vigilante corre como SYSTEM cada minuto, así que su guion tiene que estar
           donde solo escriben SYSTEM y Administradores. En C:\ProgramData\Guardiana (1.0.48) heredaba el «Modificar» que el
           servicio da al usuario de la consola en esa carpeta: cualquier programa de ese usuario podía reescribirlo y ejecutar
           código como SYSTEM. Fuera de la carpeta del programa, como antes, para que siga ahí si el programa desaparece. -->
      <Directory Id="VIGILANTEDIR" Name="GUARDIANA Vigilante" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="MenuDir" Name="Guardiana" />
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />

    <!-- The brand icon (build/wix/guardiana.ico): shortcuts and the "Programs" list. -->
    <Icon Id="guardiana.ico" SourceFile="$(var.Icon)" />
    <Property Id="ARPPRODUCTICON" Value="guardiana.ico" />

    <Feature Id="Main" Title="Guardiana" Level="1">
      <ComponentRef Id="Exe" />
      <ComponentRef Id="Readme" />
      <ComponentRef Id="Shortcut" />
      <ComponentRef Id="DesktopShortcut" />
      <ComponentRef Id="Vigilante" />
      <ComponentRef Id="Idioma" />
    </Feature>

    <Component Id="Exe" Directory="INSTALLFOLDER" Guid="3ddbdec9-0a69-4313-a914-1b9797819a7f">
      <File Id="GuardianaExe" Name="guardiana.exe" Source="$(var.Exe)" KeyPath="yes" />
      <!-- `guardiana verify` in any new command window or PowerShell, which does not accept the
           quoted path followed by a word that the readme gave (1.0.1). Removed on uninstall. -->
      <Environment Id="PathGuardiana" Name="PATH" Value="[INSTALLFOLDER]" Part="last" Action="set" System="yes" Permanent="no" />
      <ServiceInstall Id="Svc"
                      Name="guardiana"
                      DisplayName="GUARDIANA"
                      Description="!(loc.ServicioDescripcion)"
                      Type="ownProcess"
                      Start="auto"
                      ErrorControl="normal"
                      Arguments="service run"
                      Account="LocalSystem"
                      Vital="yes" />
      <ServiceControl Id="SvcCtl" Name="guardiana" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
      <!-- What Windows does when the service dies is set by the service itself, with sc.exe, each
           time it starts (service_cmd.rs). The MSI tables for it (ServiceConfig and
           ServiceConfigFailureActions) made the repair fail on the test PC on 28 Sep 2026 with
           "the service could not be configured", and a failed repair rolls back. -->
    </Component>

    <!-- El vigilante del DNS (30 Oct 2026, el dueño: «que al cliente siempre tenga el internet… todo automático»): una tarea de
         Windows (vigilante.xml) que, al encender el equipo y cada minuto, mira si GUARDIANA contesta en 127.0.0.1; si no contesta
         (servicio muerto, colgado, en cuarentena o borrado), devuelve el DNS de antes en unos 15 s. No depende de guardiana.exe.
         La tarea se crea al instalar, actualizar o reparar y se quita al desinstalar (CrearVigilante, QuitarVigilante). -->
    <Component Id="Vigilante" Directory="VIGILANTEDIR" Guid="904ccb7b-3fc5-4734-9fce-9f0bd8536d8b">
      <File Id="VigilantePs1" Name="vigilante.ps1" Source="$(sys.SOURCEFILEDIR)vigilante.ps1" KeyPath="yes" />
      <File Id="VigilanteXml" Name="vigilante.xml" Source="$(sys.SOURCEFILEDIR)vigilante.xml" />
    </Component>

    <!-- 1.0.49: el idioma del instalador que se eligió en la web, para GUARDIANA ZERO. Hasta 1.0.48 iba en HKCU dentro de los
         accesos de «ZERO=0», así que con la instalación normal no se escribía y ZERO abría en inglés (revisión del 30 Oct
         2026). Ahora, siempre y en HKLM, para todas las cuentas del equipo. -->
    <Component Id="Idioma" Directory="INSTALLFOLDER" Guid="c1405342-320f-45f1-8892-2f0a6cd1d88a">
      <RegistryValue Root="HKLM" Key="SOFTWARE\GUARDIANA GROUP\GUARDIANA" Name="idioma" Type="string" Value="$(var.Idioma)" KeyPath="yes" />
    </Component>

    <Component Id="Readme" Directory="INSTALLFOLDER" Guid="6ee79eff-4700-48d1-93d8-35f8a726cd99">
      <File Id="Leeme" Name="!(loc.ArchivoLeeme)" Source="$(var.Readme)" KeyPath="yes" />
    </Component>

    <!-- 17 Oct 2026 (the owner: «esa página negra que me aparece siempre… debe ser una descarga
         limpia»): guardiana.exe is a console program, so a shortcut to it opened a black console
         window that stayed in front while the service came up (the panel waits for its key
         before it lets the console go). Show="minimized" starts that console on the taskbar
         instead; the "Open Guardiana" box at the end of the install runs this same shortcut.
         18 Oct 2026 (the owner's video of 1.0.43: the console still showed): with GUARDIANA ZERO
         installed, the default, the shortcuts are ZERO's own further down (a window program,
         started with its panel argument: no console at all) and these two exist only with ZERO=0. Both sets are called
         «Guardiana», so the finish box (WixShellExecTarget, [MenuDir]Guardiana.lnk) runs
         whichever is there. The «Guardiana (menú)» shortcut is gone: `guardiana menu` is the
         interactive test menu in a console (crates/cli/src/menu.rs), not something to open from
         the Start menu without a console. -->
<?ifdef ZeroExe ?>
    <!-- With ZERO in the package: only when it is left out (ZERO=0). -->
    <Component Id="Shortcut" Directory="MenuDir" Guid="21398cf1-e897-4661-a755-bb36e4a4eb16" Condition="ZERO=&quot;0&quot;">
      <Shortcut Id="PanelShortcut"
                Name="Guardiana"
                Description="!(loc.AbrirPanel)"
                Target="[INSTALLFOLDER]guardiana.exe"
                Arguments="panel"
                Icon="guardiana.ico"
                Show="minimized"
                WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveMenuDir" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\Guardiana" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      <RegistryValue Root="HKCU" Key="Software\Guardiana" Name="idioma" Type="string" Value="$(var.Idioma)" />
    </Component>

    <Component Id="DesktopShortcut" Directory="DesktopFolder" Guid="9a1f6c2e-3d47-4b8a-9c05-6e2f1b7d4a10" Condition="ZERO=&quot;0&quot;">
      <Shortcut Id="DesktopPanelShortcut"
                Name="Guardiana"
                Description="!(loc.AbrirPanel)"
                Target="[INSTALLFOLDER]guardiana.exe"
                Arguments="panel"
                Icon="guardiana.ico"
                Show="minimized"
                WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue Root="HKCU" Key="Software\Guardiana" Name="desktop" Type="integer" Value="1" KeyPath="yes" />
    </Component>
<?else ?>
    <Component Id="Shortcut" Directory="MenuDir" Guid="21398cf1-e897-4661-a755-bb36e4a4eb16">
      <Shortcut Id="PanelShortcut"
                Name="Guardiana"
                Description="!(loc.AbrirPanel)"
                Target="[INSTALLFOLDER]guardiana.exe"
                Arguments="panel"
                Icon="guardiana.ico"
                Show="minimized"
                WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveMenuDir" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\Guardiana" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      <RegistryValue Root="HKCU" Key="Software\Guardiana" Name="idioma" Type="string" Value="$(var.Idioma)" />
    </Component>

    <Component Id="DesktopShortcut" Directory="DesktopFolder" Guid="9a1f6c2e-3d47-4b8a-9c05-6e2f1b7d4a10">
      <Shortcut Id="DesktopPanelShortcut"
                Name="Guardiana"
                Description="!(loc.AbrirPanel)"
                Target="[INSTALLFOLDER]guardiana.exe"
                Arguments="panel"
                Icon="guardiana.ico"
                Show="minimized"
                WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue Root="HKCU" Key="Software\Guardiana" Name="desktop" Type="integer" Value="1" KeyPath="yes" />
    </Component>
<?endif ?>

<?ifdef ZeroExe ?>
    <!-- One program (the owner, 13 Oct 2026: «instalando solo uno ya lo tiene todo»): the browser
         GUARDIANA ZERO travels inside GUARDIANA's installer, installed by default under
         Program Files\Guardiana\ZERO with its shortcuts. Same version, same licence. It uses
         Microsoft Edge WebView2, which Windows 10 and 11 already carry, so it adds about 10 MB.
         `msiexec /i ... ZERO=0` installs GUARDIANA alone. Its data stays per user in
         %LOCALAPPDATA%\GUARDIANA ZERO, the same folder the separate ZERO installer used, so a
         person who had it keeps everything. A running ZERO is asked to close (its own X) before
         its file is replaced or removed. -->
    <Property Id="ZERO" Value="1" Secure="yes" />
    <util:CloseApplication Id="CerrarZero" Target="GUARDIANA ZERO.exe" CloseMessage="yes" RebootPrompt="no" Timeout="30" />
    <Icon Id="zero.ico" SourceFile="$(var.ZeroIcon)" />
    <Feature Id="Zero" Title="GUARDIANA ZERO" Level="1">
      <Level Value="0" Condition="ZERO=&quot;0&quot;" />
      <ComponentRef Id="ZeroExe" />
      <ComponentRef Id="ZeroShortcut" />
      <ComponentRef Id="ZeroDesktopShortcut" />
      <ComponentRef Id="ZeroProtocolo" />
      <ComponentRef Id="ZeroAvisos" />
    </Feature>
    <Component Id="ZeroExe" Directory="ZERODIR" Guid="5e0c7a31-8d24-4f6b-b9a2-3c1d7e8f4a95">
      <File Id="ZeroExeFile" Name="GUARDIANA ZERO.exe" Source="$(var.ZeroExe)" KeyPath="yes" />
    </Component>
    <!-- 1.0.44, a clean start: «Guardiana» in the Start menu and on the desktop, and the finish
         box, open GUARDIANA ZERO with its panel argument (see Arguments). ZERO is a window program, so no console shows;
         its window opens at once on its own dark wait page and turns into the panel the moment
         the service answers (crates/zero/src/lanzador.rs). -->
    <Component Id="ZeroShortcut" Directory="MenuDir" Guid="bc24a3af-c4ba-4297-aa5e-2fac0894c940">
      <Shortcut Id="ZeroPanelShortcut"
                Name="Guardiana"
                Description="!(loc.AbrirPanel)"
                Target="[ZERODIR]GUARDIANA ZERO.exe"
                Arguments="--panel"
                Icon="guardiana.ico"
                WorkingDirectory="ZERODIR">
        <!-- 1.0.52: the name Windows' notices of el escudo's grave warnings go out under (crates/zero/src/avisos.rs,
             AUMID). The program also registers it for each account; the Start menu's shortcut is Windows' own way. -->
        <ShortcutProperty Key="System.AppUserModel.ID" Value="GuardianaGroup.Guardiana" />
      </Shortcut>
      <RemoveFolder Id="RemoveMenuDirZero" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\Guardiana" Name="installed-zero" Type="integer" Value="1" KeyPath="yes" />
    </Component>
    <Component Id="ZeroDesktopShortcut" Directory="DesktopFolder" Guid="0f412e8c-9422-402e-a385-37d6e9f7d380">
      <Shortcut Id="ZeroDesktopPanelShortcut"
                Name="Guardiana"
                Description="!(loc.AbrirPanel)"
                Target="[ZERODIR]GUARDIANA ZERO.exe"
                Arguments="--panel"
                Icon="guardiana.ico"
                WorkingDirectory="ZERODIR" />
      <RegistryValue Root="HKCU" Key="Software\Guardiana" Name="desktop-zero" Type="integer" Value="1" KeyPath="yes" />
    </Component>
    <!-- The licence in one click (1.0.44): the welcome email's «Activar» link is
         guardiana://activar?clave=<key>. Windows hands it to ZERO, which checks it strictly,
         opens the panel's licence page with the key filled in and waits for the person's click
         on «Activar»; nothing is activated by the link alone. Per machine (HKCR is
         HKLM\Software\Classes here), and only with ZERO, which is what opens it. -->
    <Component Id="ZeroProtocolo" Directory="ZERODIR" Guid="1a067fbf-813f-4a03-8231-4c1dc16f7a26">
      <RegistryKey Root="HKCR" Key="guardiana">
        <RegistryValue Type="string" Value="URL:GUARDIANA" KeyPath="yes" />
        <RegistryValue Name="URL Protocol" Type="string" Value="" />
        <RegistryKey Key="DefaultIcon">
          <RegistryValue Type="string" Value="&quot;[ZERODIR]GUARDIANA ZERO.exe&quot;,0" />
        </RegistryKey>
        <RegistryKey Key="shell\open\command">
          <RegistryValue Type="string" Value="&quot;[ZERODIR]GUARDIANA ZERO.exe&quot; --url &quot;%1&quot;" />
        </RegistryKey>
      </RegistryKey>
    </Component>
    <!-- 1.0.52 (the owner, 1 Nov 2026, 19:29, to the proposal of a Windows notice for each grave warning of the
         antivirus: «Me parece bien la propuesta, sí, buena idea»): ZERO with its notices option («avisos») starts at every sign-in, for
         every account, with no visible window, reads el escudo's warnings and shows Windows' notice of each new grave
         one; a click opens Órbita on the Antivirus (guardiana://escaner). Its hidden window takes the «close GUARDIANA
         ZERO» above, so an update or an uninstall closes it too. -->
    <Component Id="ZeroAvisos" Directory="ZERODIR" Guid="82e59daa-fdc2-4868-a561-dd5d3dc53066">
      <RegistryValue Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Run" Name="GUARDIANA avisos" Type="string" Value="&quot;[ZERODIR]GUARDIANA ZERO.exe&quot; --avisos" KeyPath="yes" />
    </Component>
<?endif ?>

    <!-- Uninstall only: after the service is stopped and before it is deleted.
         Not on upgrade (UPGRADINGPRODUCTCODE) and not on repair (REINSTALL): a
         "Repair" from Programs and Features sets REMOVE=ALL for the components
         without setting UPGRADINGPRODUCTCODE, so with only the first condition a
         repair turned Home Mode off and put the old DNS back - measured on the
         test Windows on 16 sep 2026, and the phones in the house lost their DNS
         without anyone asking for it. Repairing must never remove protection. -->
    <!-- 16 Oct 2026 (the owner: «pantallazos negros, tirones»): guardiana.exe is a console
         program, so an ExeCommand flashed a black window at every step. WixQuietExec runs the
         same commands with no window; a deferred action reads its command line from the
         property of its own name, set just before it in the execute sequence. -->
    <SetProperty Id="HomeOff" Value="&quot;[INSTALLFOLDER]guardiana.exe&quot; hogar off --desinstalando" Before="HomeOff" Sequence="execute" />
    <CustomAction Id="HomeOff"
                  DllEntry="WixQuietExec"
                  BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />
    <SetProperty Id="RestoreDns" Value="&quot;[INSTALLFOLDER]guardiana.exe&quot; dns --restore --desinstalando" Before="RestoreDns" Sequence="execute" />
    <CustomAction Id="RestoreDns"
                  DllEntry="WixQuietExec"
                  BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />
    <!-- First install only: point this PC's DNS at Guardiana once the service is listening.
         Never on an upgrade or a repair (the person may have undone it on purpose) and never
         allowed to fail the install: if it cannot be done, the panel still has its button. -->
    <Property Id="VIGILAR" Value="1" Secure="yes" />
    <SetProperty Id="ApplyDns" Value="&quot;[INSTALLFOLDER]guardiana.exe&quot; dns --apply --yes --instalador" Before="ApplyDns" Sequence="execute" />
    <CustomAction Id="ApplyDns"
                  DllEntry="WixQuietExec"
                  BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />
    <!-- El vigilante del DNS: la tarea de Windows, creada con los archivos ya en su sitio y quitada al desinstalar de verdad
         (no al actualizar ni al reparar). Nunca hace fallar la instalación. -->
    <SetProperty Id="CrearVigilante" Value="&quot;[System64Folder]schtasks.exe&quot; /Create /TN &quot;\GUARDIANA\Vigilante&quot; /XML &quot;[VIGILANTEDIR]vigilante.xml&quot; /F" Before="CrearVigilante" Sequence="execute" />
    <CustomAction Id="CrearVigilante"
                  DllEntry="WixQuietExec"
                  BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />
    <SetProperty Id="QuitarVigilante" Value="&quot;[System64Folder]schtasks.exe&quot; /Delete /TN &quot;\GUARDIANA\Vigilante&quot; /F" Before="QuitarVigilante" Sequence="execute" />
    <CustomAction Id="QuitarVigilante"
                  DllEntry="WixQuietExec"
                  BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />
    <!-- 1.0.49 (revisión del 30 Oct 2026): si la instalación se cancela o falla después de crear la tarea o de poner el DNS,
         Windows deshace los archivos y el servicio; estas tres acciones deshacen también lo nuestro (la tarea, el DNS, y la tarea
         quitada al desinstalar). -->
    <SetProperty Id="CrearVigilanteAtras" Value="&quot;[System64Folder]schtasks.exe&quot; /Delete /TN &quot;\GUARDIANA\Vigilante&quot; /F" Before="CrearVigilanteAtras" Sequence="execute" />
    <CustomAction Id="CrearVigilanteAtras" DllEntry="WixQuietExec" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" Execute="rollback" Impersonate="no" Return="ignore" />
    <SetProperty Id="ApplyDnsAtras" Value="&quot;[INSTALLFOLDER]guardiana.exe&quot; dns --restore --desinstalando" Before="ApplyDnsAtras" Sequence="execute" />
    <CustomAction Id="ApplyDnsAtras" DllEntry="WixQuietExec" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" Execute="rollback" Impersonate="no" Return="ignore" />
    <SetProperty Id="QuitarVigilanteAtras" Value="&quot;[System64Folder]schtasks.exe&quot; /Create /TN &quot;\GUARDIANA\Vigilante&quot; /XML &quot;[VIGILANTEDIR]vigilante.xml&quot; /F" Before="QuitarVigilanteAtras" Sequence="execute" />
    <CustomAction Id="QuitarVigilanteAtras" DllEntry="WixQuietExec" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" Execute="rollback" Impersonate="no" Return="ignore" />
    <!-- Lo que dice la barra de progreso mientras corren nuestras acciones (antes, la línea quedaba vacía) -->
    <UI>
      <ProgressText Action="CrearVigilante" Message="!(loc.ProgresoVigilante)" />
      <ProgressText Action="ApplyDns" Message="!(loc.ProgresoDns)" />
      <ProgressText Action="HomeOff" Message="!(loc.ProgresoHogar)" />
      <ProgressText Action="RestoreDns" Message="!(loc.ProgresoDevolverDns)" />
      <ProgressText Action="QuitarVigilante" Message="!(loc.ProgresoQuitarVigilante)" />
    </UI>
    <InstallExecuteSequence>
      <Custom Action="CrearVigilanteAtras" Before="CrearVigilante" Condition="NOT Installed AND NOT WIX_UPGRADE_DETECTED" />
      <Custom Action="ApplyDnsAtras" Before="ApplyDns" Condition="VIGILAR=&quot;1&quot; AND NOT Installed AND NOT WIX_UPGRADE_DETECTED AND NOT REMOVE" />
      <Custom Action="QuitarVigilanteAtras" Before="QuitarVigilante" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE AND NOT REINSTALL" />
      <Custom Action="CrearVigilante" After="InstallFiles" Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="QuitarVigilante" After="RestoreDns" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE AND NOT REINSTALL" />
      <Custom Action="ApplyDns" After="StartServices" Condition="VIGILAR=&quot;1&quot; AND NOT Installed AND NOT WIX_UPGRADE_DETECTED AND NOT REMOVE" />
      <Custom Action="HomeOff" After="StopServices" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE AND NOT REINSTALL" />
      <Custom Action="RestoreDns" After="HomeOff" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE AND NOT REINSTALL" />
    </InstallExecuteSequence>
  </Package>
</Wix>
