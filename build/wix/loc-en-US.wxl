<?xml version="1.0" encoding="utf-8"?>
<!-- The installer's texts in English. Someone downloading from the English page used to get a
     Spanish installer, which is no way to ask for their trust (22 Sep 2026). -->
<WixLocalization xmlns="http://wixtoolset.org/schemas/v4/wxl" Culture="en-US" Codepage="1252">
  <String Id="Descripcion" Value="GUARDIANA: the ZERO browser, monitoring of the whole computer and the Watch. Everything happens on this computer, with no account." />
  <String Id="AbrirPanel" Value="Open the GUARDIANA panel" />
  <String Id="AbrirZero" Value="Open the GUARDIANA ZERO browser" />
  <String Id="VersionMasNueva" Value="A newer version of GUARDIANA is already installed." />
  <String Id="ServicioDescripcion" Value="GUARDIANA: watches which companies this computer connects to and protects its DNS. Everything happens on this computer, with no account." />
  <String Id="ArchivoLeeme" Value="README.txt" />
  <!-- 1.0.49: la barra de progreso y las pantallas de WixUI con nuestras palabras (revisión del 30 Oct 2026: la primera
       pedía aceptar un «contrato» que no existe y la última no decía que GUARDIANA quedó en marcha) -->
  <String Id="ProgresoCerrarZero" Value="Closing GUARDIANA ZERO to update it…" />
  <String Id="ProgresoVigilante" Value="Creating the DNS watcher…" />
  <String Id="ProgresoDns" Value="Setting up this computer’s DNS…" />
  <String Id="ProgresoHogar" Value="Closing Home Mode…" />
  <String Id="ProgresoDevolverDns" Value="Giving the previous DNS back…" />
  <String Id="ProgresoQuitarVigilante" Value="Removing the DNS watcher…" />
  <String Id="WelcomeEulaDlgTitle" Value="{\WixUI_Font_Title}Before installing GUARDIANA" />
  <String Id="WelcomeEulaDlgLicenseAcceptedCheckBox" Value="I have read what the installation will do and I accept the Terms of use" />
  <!-- 3 Nov 2026: the last screen no longer shows when installing (GUARDIANA opens by itself and the window closes),
       so ExitDialogTitle and ExitDialogDescription, with their «Click “Finish” to close», are gone: only «msiexec /a»
       would show it, with WixUI's own words. The page while installing (InstalandoDlg) and what each step says: -->
  <String Id="InstalandoTitulo" Value="Installing GUARDIANA on your PC" />
  <String Id="InstalandoProteccion" Value="Starting the protection" />
  <String Id="InstalandoZero" Value="Getting the GUARDIANA ZERO browser ready" />
  <String Id="InstalandoDns" Value="Making GUARDIANA this PC’s DNS" />
  <String Id="ProgresoAbrir" Value="Opening GUARDIANA…" />
  <String Id="PasoPreparar" Value="Preparing the changes…" />
  <String Id="PasoWindows" Value="Recording the changes in Windows…" />
  <String Id="PasoParaServicio" Value="Stopping the GUARDIANA service…" />
  <String Id="PasoQuitaServicio" Value="Removing the GUARDIANA service…" />
  <String Id="PasoRegistraServicio" Value="Registering the GUARDIANA service…" />
  <String Id="PasoArrancaServicio" Value="Starting the GUARDIANA service…" />
  <String Id="PasoQuitaArchivos" Value="Removing GUARDIANA’s files…" />
  <String Id="PasoCopiaArchivos" Value="Copying GUARDIANA’s files…" />
  <String Id="PasoAccesos" Value="Creating GUARDIANA’s shortcuts…" />
  <String Id="PasoTerminar" Value="Finishing…" />
  <String Id="PasoDeshacer" Value="Undoing the changes…" />
</WixLocalization>
