#!/bin/sh
# Guardiana .deb: enable and start the service. The system DNS is NOT changed
# here; that happens from the panel, with consent, on first use (brief §11).
set -e
mkdir -p /var/lib/guardiana
chmod 700 /var/lib/guardiana
if [ -d /run/systemd/system ]; then
    systemctl daemon-reload || true
    systemctl enable guardiana.service || true
    # restart, not «enable --now»: on an upgrade the old process is still running, and
    # «--now» leaves it there, with its deleted binary, until the next reboot. None of the new
    # version's fixes were active (review of 5 Oct 2026). restart also starts a stopped one.
    systemctl restart guardiana.service || true
fi
# In the terminal's language, as the .tar.gz installer does (review of 5 Oct 2026). The panel key
# belongs to the service, so a person opens the panel with sudo, which prints the link.
case "${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}" in
    es* | "" | C | C.* | POSIX) echo "GUARDIANA instalada. Para abrir el panel: sudo guardiana panel"
        echo "Comunicaciones (chat y llamadas): en el menú de aplicaciones, «GUARDIANA Comunicaciones», o con tu usuario y sin sudo: guardiana comunicaciones" ;;
    pt*) echo "GUARDIANA instalada. Para abrir o painel: sudo guardiana panel"
        echo "Comunicações (chat e chamadas): no menu de aplicativos, «GUARDIANA Comunicações», ou com o seu usuário e sem sudo: guardiana comunicaciones" ;;
    *) echo "GUARDIANA installed. To open the panel: sudo guardiana panel"
        echo "Communications (chat and calls): in the applications menu, “GUARDIANA Communications”, or as your own user and without sudo: guardiana comunicaciones" ;;
esac
exit 0
